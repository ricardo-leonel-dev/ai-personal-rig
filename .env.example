# ============================================================
# .env.example — copy this to .env and fill in your values
# This file is safe to commit. .env is NOT.
# ============================================================

# Your Hugging Face token (needs read access to gated models)
# Get one at: https://huggingface.co/settings/tokens
# NOTE: rotate your old token — it was exposed in the compose file
HF_TOKEN=PUT_HERE

# Random secret for Open WebUI session encryption
# Generate with: openssl rand -hex 32
OPEN_WEBUI_SECRET=PUT_HERE

# IP address of this machine on your local network
# This is used in setup.sh to print n8n connection instructions
SERVER_IP=192.168.1.X
